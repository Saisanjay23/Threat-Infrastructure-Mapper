# Copy to .env (setup.bat does this and generates a random secret key).
TIM_ENVIRONMENT=development
TIM_HOST=127.0.0.1
TIM_PORT=8000
TIM_MONGO_URI=mongodb://127.0.0.1:27017
TIM_MONGO_DB=tim
TIM_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
TIM_ACCESS_TOKEN_MINUTES=480
TIM_ADMIN_USERNAME=admin
TIM_ADMIN_PASSWORD=ChangeMe!2026
TIM_ADMIN_EMAIL=admin@tim.local
TIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIM_SCREENSHOTS_ENABLED=true
TIM_ALLOW_PRIVATE_TARGETS=false
TIM_MAX_CONCURRENT_INVESTIGATIONS=4
